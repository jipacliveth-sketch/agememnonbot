# Copy this file to .env for local development.
# Never commit .env or replace these placeholders with real credentials here.

NODE_ENV=development

# Telegram
TELEGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_URL=https://example.invalid/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_TELEGRAM_WEBHOOK_SECRET
TELEGRAM_USE_WEBHOOK=false

# Database and Redis
DATABASE_URL=REPLACE_WITH_DATABASE_URL
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://example.invalid/upstash-rest
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_UPSTASH_REDIS_REST_TOKEN

# Application
PORT=3000
LOG_LEVEL=info

# Blockchain providers
SOLANA_RPC_URL=https://example.invalid/solana-rpc
BSC_RPC_URL=https://example.invalid/bsc-rpc
BSC_USDT_CONTRACT_ADDRESS=
DEPOSIT_WATCH_INTERVAL_MS=30000
RECONCILIATION_INTERVAL_MS=300000

# Security
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Withdrawal limits
WITHDRAWAL_MIN_AMOUNT=0.000001
WITHDRAWAL_MAX_AMOUNT=1000000